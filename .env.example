# ---------------------------------------------------------------------------
# Machine Science — public website
#
# Production hosts:
#   https://msj.aztu.edu.az        this site
#   https://api-msj.aztu.edu.az    backend API
#   https://admin-msj.aztu.edu.az  author + editor portal
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, so they
# must be set before `next build` — setting them only at run time has no effect.
# ---------------------------------------------------------------------------

# Backend origin used by server components and by the /api + /files rewrites.
# In Docker this is usually the internal service name (e.g. http://backend:8080).
API_URL=https://api-msj.aztu.edu.az

# Backend origin as the browser would reach it. Only used for the preconnect
# resource hint — browser traffic goes through the same-origin /api rewrite.
NEXT_PUBLIC_API_URL=https://api-msj.aztu.edu.az

# Canonical origin of this site: canonical URLs, JSON-LD, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://msj.aztu.edu.az

# Author sign-in and manuscript submission (the admin app).
NEXT_PUBLIC_ADMIN_URL=https://admin-msj.aztu.edu.az

# Search-console ownership tokens. Leave unset until the property is claimed —
# an unset variable omits the tag rather than emitting an empty one.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_VERIFICATION=
# NEXT_PUBLIC_YANDEX_VERIFICATION=

# ---- local development ----------------------------------------------------
# Point the two API variables at a locally running backend instead:
# API_URL=http://localhost:8081
# NEXT_PUBLIC_API_URL=http://localhost:8081
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_ADMIN_URL=http://localhost:5000
